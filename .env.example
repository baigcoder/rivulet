# Only for `tauri:dev:android`: the address a phone or TV reaches the dev
# server on. Left set for the desktop it sends Vite's reload socket to
# ws://0.0.0.0, which nothing can open, and the boot screen reports a crash.
# TAURI_DEV_HOST=0.0.0.0
TAURI_APPLE_DEVELOPMENT_TEAM=12345
APPLE_DEVELOPMENT_TEAM=12345

TMDB_API=test
