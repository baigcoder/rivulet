node_modules
.DS_Store
*.log*
.data
.nuxt
.nitro
.cache
.output
.env
.cargo
dist
src-tauri/target
src-tauri/target-android
# Downloaded by scripts/build/mpv.ts and bundled into Windows builds.
src-tauri/mpv
# Created by build.rs, filled by scripts/build/macos/bundle-dylib.ts, bundled into the macOS .app.
src-tauri/dylibs

# A stray dev database: the real ones live in the app's data directory
# (see `lib.rs`), so anything here is a leftover from a local run.
src-tauri/*.db

# Local editor/agent state.
.claude/settings.local.json

# The APK signing key. It lives in a GitHub secret (see .github/workflows/release.yml);
# a copy landing here would hand anyone the ability to publish an upgrade to Rivulet.
*.jks
*.keystore

# Written by packaging/flatpak/generate-sources.sh — a venv, a clone of
# flatpak-builder-tools, and the two multi-megabyte source manifests that belong
# in the flathub repo rather than this one. The generated manifest also has the
# TMDB token substituted into it.
packaging/flatpak/generated
